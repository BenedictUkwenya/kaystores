# App URL — used in email links (passed to Edge Functions in request body).
# Local: http://localhost:3000
# Production: https://kaystores.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — invokes Edge Functions (NOT Resend; see supabase/SECRETS.md)
SUPABASE_SERVICE_ROLE_KEY=

# AI suggestion engine (future)
OPENAI_API_KEY=

# Resend + team email → Supabase Edge Function secrets (supabase/SECRETS.md)
# Do NOT put RESEND_API_KEY in this file.
