# App URL — used for local redirects / metadata.
# Email invite links never use localhost; they fall back to https://shoponkay.com
# unless this is set to a non-local URL (or you're on Vercel production).
# Local: http://localhost:3000
# Production (Vercel): https://shoponkay.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — invokes Edge Functions (NOT Resend; see supabase/SECRETS.md)
SUPABASE_SERVICE_ROLE_KEY=

# AI: category suggestions (LLM) + product embeddings (semantic similarity)
# Without this key, category suggest uses keyword rules; similarity uses metadata only.
OPENAI_API_KEY=

# Flutterwave (legacy — optional; Paystack is the live gateway)
FLUTTERWAVE_SECRET_KEY=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# Paystack (https://dashboard.paystack.com/#/settings/developers)
# Live webhook URL: https://www.shoponkay.com/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Terminal Africa (https://www.terminal.africa/) — server-only shipping credentials.
# Set TERMINAL_HUB_ADDRESS_JSON to a one-line JSON AddressDetails object, e.g.
# {"line1":"...","city":"Lagos","state":"Lagos","postalCode":"100001","country":"Nigeria"}
# Webhooks verify X-Terminal-Signature with HMAC-SHA512 of this secret key.
TERMINAL_AFRICA_SECRET_KEY=
TERMINAL_HUB_ADDRESS_JSON=
TERMINAL_HUB_CONTACT_NAME=
TERMINAL_HUB_CONTACT_EMAIL=
TERMINAL_HUB_CONTACT_PHONE=

# Resend + team email → Supabase Edge Function secrets (supabase/SECRETS.md)
# Do NOT put RESEND_API_KEY in this file.
